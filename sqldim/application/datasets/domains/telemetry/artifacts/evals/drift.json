{
  "domain": "telemetry",
  "cases": [
    {
      "id": "telemetry.drift.mobile_migration",
      "event_fn": "apply_mobile_migration",
      "event_description": "All Tablet devices reclassified as Mobile",
      "probes": [
        {
          "id": "telemetry.drift.probe.devices_by_type",
          "dataset": "telemetry",
          "utterance": "how many devices are there of each device type?",
          "expect_result": true,
          "expect_columns": [
            "device_type"
          ],
          "tags": [
            "drift",
            "metric",
            "devices"
          ]
        },
        {
          "id": "telemetry.drift.probe.browser_share",
          "dataset": "telemetry",
          "utterance": "what is the browser share across all devices?",
          "expect_result": true,
          "expect_columns": [
            "browser_type"
          ],
          "tags": [
            "drift",
            "metric",
            "browsers"
          ]
        }
      ]
    },
    {
