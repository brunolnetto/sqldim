{
  "domain": "growth",
  "cases": [
    {
      "id": "growth.drift.reorg",
      "event_fn": "apply_reorg",
      "event_description": "HR department renamed to Operations",
      "probes": [
        {
          "id": "growth.drift.probe.headcount_by_dept",
